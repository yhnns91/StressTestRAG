{
  "_comment": "Section headings per document, used by scripts/build_chunks.py to place chunk boundaries. Assignment section 7.1 requires a chunk to hold one self-contained unit of meaning, so boundaries follow the document's own headings rather than a token target. Headings are matched against whole lines after whitespace normalisation, case-insensitively. Anything before the first heading becomes a leading chunk carrying the heading given in `preamble_heading`.",
  "chunking": {
    "target_tokens": 250,
    "min_tokens": 25,
    "max_tokens": 320,
    "split_long_sections_on": "blank_line",
    "_note_target": "target_tokens and max_tokens follow docs/schema.md (180-320). min_tokens is far below that range on purpose: section 7.1 allows short checklists and FAQ entries to form smaller chunks, and much of this corpus is exactly that. The four NWS flood alert definitions run 34-100 tokens each and are the intended evidence for three baseline questions, so a 180 token floor would discard them. Anything under 25 tokens is an extraction fragment rather than a unit of meaning.",
    "template_markers": [
      "include a summary of",
      "include information about",
      "include the purpose",
      "include the process",
      "include process for",
      "include commonly used terms",
      "in your cirp, include",
      "detail any resulting actions",
      "include a list of",
      "include details of"
    ],
    "_note_markers": "A chunk whose text is dominated by these phrases is an instruction telling the reader to supply their own content, not a fact that can answer a question. Such chunks are written out with quality_flag = rejected rather than dropped, so the exclusion stays auditable (CYB screening report, risk 7.3). Flagging is automatic and the resulting list must be reviewed by hand.",
    "non_evidence_headings": [
      "take an active",
      "take an active role in",
      "front matter",
      "flooding resources",
      "disclaimer:",
      "learn more",
      "explore more resources"
    ],
    "_note_non_evidence": "Publisher furniture: app promotions, page banners and disclaimers. Written out with quality_flag = rejected so the exclusion stays visible rather than silently dropped."
  },
